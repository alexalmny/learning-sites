[Unit]
Description=Expire unconfirmed static release for %i

[Service]
Type=oneshot
User=%i
ExecStart=/usr/local/libexec/static-release-receive --config /etc/static-release/%i.json --expire
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
IPAddressDeny=any
